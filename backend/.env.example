DATABASE_URL="******localhost:5432/edu_platform?schema=public"
PORT=3001
HOST=0.0.0.0

# Code execution is proxied through Judge0.
# JUDGE0_API_KEY is required in production startup validation.
JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com
